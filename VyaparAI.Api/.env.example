# Copy this file to ".env" in the VyaparAI.Api folder and fill in real values.
# Copy this file to ".env" in the VyaparAI.Api folder and fill in real values.
# .env is loaded automatically at startup via DotNetEnv (see Program.cs).
# NEVER commit the real .env file.

# MongoDB
MONGODB_CONNECTION_STRING=mongodb://localhost:27017
MONGODB_DATABASE_NAME=VyaparAI

# JWT
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=VyaparAI
JWT_AUDIENCE=VyaparAIUsers

# Gemini AI (added in Phase 6)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# CORS
FRONTEND_URL=http://localhost:5173
